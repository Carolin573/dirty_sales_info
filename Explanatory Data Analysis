
--  Explore All Columns in the Database
SELECT * FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'dirty_cafe_sales_info'

--  Dimension Exploration

-- Explore all item in the store
SELECT DISTINCT Item FROM dirty_cafe_sales_info

-- Explore all Location the customer buy the product
SELECT DISTINCT Location FROM dirty_cafe_sales_info

-- Understand the scope of data and the timespan
SELECT
MAX(Transaction_Date) AS last_order_date,
MIN(Transaction_Date) AS first_order_date,
DATEDIFF(month, MIN(Transaction_Date), MAX(Transaction_Date)) AS order_range_month
FROM dirty_cafe_sales_info

-- Measures Exploration

-- Find the Total_Sales
SELECT SUM(Total_Spent) AS Total_sales FROM dirty_cafe_sales_info

-- Find how many items are sold
SELECT
COUNT(Quantity) AS Total_Item_sold
FROM dirty_cafe_sales_info

-- Find the average selling price
SELECT AVG(Total_Spent) AS Average_Sales_Price FROM dirty_cafe_sales_info

-- Find the total number of orders
SELECT SUM(Quantity) AS Total_Quantity FROM dirty_cafe_sales_info

-- Find the total number of products
SELECT COUNT(Item) AS Number_of_product FROM dirty_cafe_sales_info

-- Find the total number of customers
SELECT COUNT(Transaction_ID) AS Total_customer FROM dirty_cafe_sales_info

-- Find the total number of customers that has placed an order
SELECT COUNT(DISTINCT Transaction_ID) AS Total_Nr_Customer
FROM dirty_cafe_sales_info

-- Generate a report that shows all key metrics of the business (shows only product name and values of product name)

SELECT 'Total Sales' AS measure_name, SUM(Total_Spent) AS measure_value FROM dirty_cafe_sales_info
UNION ALL
SELECT 'Total_Item_sold', COUNT(Quantity) FROM dirty_cafe_sales_info
UNION ALL
SELECT 'Average_Sales_Price', AVG(Total_Spent)  FROM dirty_cafe_sales_info
UNION ALL
SELECT 'Total_Quantity', SUM(Quantity) FROM dirty_cafe_sales_info
UNION ALL
SELECT 'Number_of_product', COUNT(Item)  FROM dirty_cafe_sales_info
UNION ALL
SELECT 'Total_customer', COUNT(Transaction_ID) FROM dirty_cafe_sales_info
UNION ALL
SELECT 'Total_Nr_Customer', COUNT(DISTINCT Transaction_ID) FROM dirty_cafe_sales_info


-- Find total customers by location
SELECT
Location,
COUNT(Transaction_ID) AS Total_Customer_Loc
FROM dirty_cafe_sales_info
GROUP BY Location
ORDER BY Total_Customer_Loc DESC;

-- Find total customers by item
SELECT
Item,
COUNT(Transaction_ID) AS Total_customer_item
FROM dirty_cafe_sales_info
GROUP BY Item
ORDER BY Total_customer_item DESC;

-- Find total product by quantity
SELECT
Item,
SUM(Quantity) AS Total_Product_Quantity
FROM dirty_cafe_sales_info
GROUP BY Item
ORDER BY Total_Product_Quantity DESC

-- Find average cost by Price_Per_Unit
SELECT
Item,
AVG(Price_Per_Unit) AS Avg_Price_Per_Unit
FROM dirty_cafe_sales_info
GROUP BY Item
ORDER BY Avg_Price_Per_Unit DESC

-- Find total revenue per Item
SELECT
Item,
SUM(Total_Spent) AS Total_Revenue
FROM dirty_cafe_sales_info
GROUP BY Item

-- Find total revenue by each customer
SELECT
Transaction_ID,
SUM(Total_Spent) AS Total_Revenue_Each_Customer
FROM dirty_cafe_sales_info
GROUP BY Transaction_ID
ORDER BY Total_Revenue_Each_Customer desc

-- The distribution of sold items across Location
SELECT Location,
COUNT(Quantity) AS total_sold_items
FROM dirty_cafe_sales_info
GROUP BY Location
ORDER BY total_sold_items DESC

-- Which three (3) Products generate the highest revenue
SELECT TOP 3
Item,
SUM(Total_Spent) AS Total_Revenue_Each_Customer
FROM dirty_cafe_sales_info
GROUP BY Item
ORDER BY Total_Revenue_Each_Customer DESC

-- Using window function
SELECT *
FROM
	(SELECT
	Item,
	SUM(Total_Spent) AS Total_Revenue_Each_Customer,
	ROW_NUMBER() OVER (ORDER BY SUM(Total_Spent) DESC) AS Rank_Item
	FROM dirty_cafe_sales_info
	GROUP BY Item)t
WHERE Rank_Item <= 3
